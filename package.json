{
  "name": "jadeview-playground",
  "version": "0.2.0",
  "private": true,
  "description": "An open-source Python + React playground for JadeView NEXT",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "pack:asar": "python scripts/pack_asar.py",
    "test": "python -m unittest discover -s tests -v"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "motion": "^14.3.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "^7.0.0"
  }
}
